# Each developer keeps their own .env locally (it is git-ignored, never committed).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=        # your MySQL root password (leave empty if it has none)
DB_NAME=fullstack6
PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret
